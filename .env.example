# Backend Environment Configuration Example
# Copy this file or backend/.env.example to backend/.env

# Server Port
PORT=5000

# ==========================================
# Database Connection (DATABASE_URL)
# ==========================================

# Option 1: Docker MySQL Container (Default)
DATABASE_URL="mysql://root:rootpassword@localhost:3307/restaurant_db"

# Option 2: Local Installed MySQL (No Docker - XAMPP / Laragon / Native MySQL)
# DATABASE_URL="mysql://root:your_password@localhost:3306/restaurant_db"

# Option 3: SQLite (No Docker / No MySQL Server required)
# DATABASE_URL="file:./dev.db"
