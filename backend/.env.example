# ==========================================
# Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# ==========================================
# Database Connection (DATABASE_URL)
# Choose one of the following scenarios:
# ==========================================

# ------------------------------------------
# Scenario 1: Docker MySQL (Default Setup)
# ------------------------------------------
# Using docker-compose up -d in backend/
# Docker maps host port 3307 to container port 3306
DATABASE_URL="mysql://root:rootpassword@localhost:3307/restaurant_db"

# ------------------------------------------
# Scenario 2: Local MySQL (Without Docker - XAMPP / Laragon / Native MySQL)
# ------------------------------------------
# If running native MySQL installed on your system (default port 3306)
# Note: Ensure you create database 'restaurant_db' or Prisma will push schema to it
# DATABASE_URL="mysql://root:your_password@localhost:3306/restaurant_db"

# ------------------------------------------
# Scenario 3: SQLite (Zero Setup - No Docker & No MySQL Server Required)
# ------------------------------------------
# If you don't have Docker or MySQL installed, use SQLite:
# 1. Copy schema.sqlite.prisma to schema.prisma:
#    cp prisma/schema.sqlite.prisma prisma/schema.prisma (or copy/paste on Windows)
# 2. Set DATABASE_URL to a file path below:
# DATABASE_URL="file:./dev.db"
